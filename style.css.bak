* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #00ff41;
    --primary-dim: #00cc33;
    --primary-glow: rgba(0, 255, 65, 0.4);
    --bg-primary: #000000;
    --bg-secondary: #0a0a0a;
    --bg-panel: rgba(10, 10, 10, 0.8);
    --border: rgba(0, 255, 65, 0.3);
    --border-dim: rgba(0, 255, 65, 0.15);
    --text-primary: #00ff41;
    --text-secondary: #00cc33;
    --text-dim: #008822;
    --error: #ff3333;
}

html {
    font-size: 16px;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg-primary);
    color: var(--text-primary);
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
    line-height: 1.6;
}

.fx-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
}

.bg-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, 0.8) 100%);
    pointer-events: none;
    z-index: 1;
}

.grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
        linear-gradient(rgba(0, 255, 65, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 255, 65, 0.05) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.3;
}

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.85) 100%);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    z-index: 100;
    box-shadow: 0 4px 30px rgba(0, 255, 65, 0.1);
}

.nav-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
}

.nav-logo {
    display: flex;
    align-items: baseline;
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
}

.logo-k {
    color: var(--primary);
    font-size: 2.2rem;
    text-shadow: 0 0 20px var(--primary-glow);
}

.logo-text {
    color: var(--primary);
    text-shadow: 0 0 20px var(--primary-glow);
}

.nav-links {
    display: flex;
    gap: 2rem;
}

.nav-btn {
    background: transparent;
    border: none;
    color: var(--text-dim);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    padding: 0.5rem 0;
    position: relative;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.nav-btn:hover {
    color: var(--text-primary);
}

.nav-btn.active {
    color: var(--text-primary);
}

.nav-btn.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary);
    box-shadow: 0 0 10px var(--primary-glow);
}

.nav-auth {
    display: flex;
    align-items: center;
    gap: 1rem;
}

#authSection, #userSection {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.auth-btn {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.auth-btn:hover {
    border-color: var(--primary);
    color: var(--text-primary);
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
}

.auth-btn.primary {
    border-color: var(--border);
    color: var(--text-primary);
    background: rgba(0, 255, 65, 0.05);
}

.auth-btn.primary:hover {
    background: rgba(0, 255, 65, 0.1);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.3);
}

.username-display {
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
}

.main-content {
    position: relative;
    z-index: 2;
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 2rem 4rem;
}

.tab-content {
    display: none;
}

.tab-content.active {
    display: block;
}

.hero-section {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem 0;
}

.hero-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 40px var(--primary-glow);
}

.hero-k {
    font-size: 4.5rem;
}

.hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 500;
}

.page-header {
    text-align: center;
    margin-bottom: 3rem;
    padding: 2rem 0;
}

.page-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 3rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 30px var(--primary-glow);
}

.page-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
}

.scanner-panel, .hitlist-panel, .lookup-panel, .credits-panel, .results-panel, .profile-panel, .lookup-result-panel {
    background: var(--bg-panel);
    border: 1px solid var(--border);
    backdrop-filter: blur(20px);
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 20px rgba(0, 255, 65, 0.05);
}

.panel-header {
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-dim);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.panel-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--text-primary);
}

.panel-header-btn {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    padding: 0.375rem 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.panel-header-btn:hover {
    border-color: var(--primary);
    color: var(--text-primary);
}

.panel-body {
    padding: 1.5rem;
}

.config-grid {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
}

.config-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.config-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
    letter-spacing: 0.05em;
}

.config-select {
    background: var(--bg-secondary);
    border: 1px solid var(--border-dim);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.625rem 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.config-select:hover {
    border-color: var(--border);
}

.config-select:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
}

.year-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.year-btn {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    padding: 0.5rem 0.875rem;
    cursor: pointer;
    transition: all 0.3s ease;
}

.year-btn:hover {
    border-color: var(--primary);
    color: var(--text-primary);
}

.year-btn.active {
    background: rgba(0, 255, 65, 0.1);
    border-color: var(--primary);
    color: var(--text-primary);
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
}

.scan-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.scan-btn {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    padding: 0.625rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.scan-btn:hover:not(:disabled) {
    border-color: var(--primary);
    color: var(--text-primary);
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.2);
}

.scan-btn.primary {
    border-color: var(--primary);
    color: var(--text-primary);
    background: rgba(0, 255, 65, 0.05);
}

.scan-btn.primary:hover:not(:disabled) {
    background: rgba(0, 255, 65, 0.1);
    box-shadow: 0 0 25px rgba(0, 255, 65, 0.3);
}

.scan-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

.status-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
}

.status-indicator {
    color: var(--primary);
    animation: blink 1s infinite;
}

@keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
}

.status-stats {
    margin-left: auto;
    color: var(--text-dim);
}

.status-bar.error {
    border-color: var(--error);
}

.status-bar.error .status-indicator,
.status-bar.error #statusText {
    color: var(--error);
}

.results-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
}

.table-container {
    max-height: 500px;
    overflow-y: auto;
    overflow-x: auto;
}

.results-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
}

.results-table thead {
    position: sticky;
    top: 0;
    background: var(--bg-secondary);
    z-index: 10;
}

.results-table th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border-dim);
    white-space: nowrap;
}

.results-table td {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid rgba(0, 255, 65, 0.08);
    color: var(--text-secondary);
    white-space: nowrap;
}

.results-table tbody tr {
    cursor: pointer;
    transition: all 0.2s ease;
}

.results-table tbody tr:hover {
    background: rgba(0, 255, 65, 0.05);
}

.results-table tbody tr.selected {
    background: rgba(0, 255, 65, 0.1);
}

.results-table tbody tr.selected td {
    color: var(--text-primary);
}

.username-cell {
    color: var(--text-primary) !important;
    font-weight: 500;
}

.table-btn {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    padding: 0.25rem 0.625rem;
    cursor: pointer;
    transition: all 0.2s ease;
}

.table-btn:hover {
    border-color: var(--primary);
    color: var(--text-primary);
}

.empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-dim);
    font-size: 0.9rem;
}

.profile-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.profile-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
}

.profile-avatar-container {
    width: 80px;
    height: 80px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
}

.profile-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.profile-avatar-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--text-dim);
    background: var(--bg-secondary);
}

.profile-info {
    flex: 1;
    min-width: 0;
}

.profile-display-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    word-break: break-word;
}

.profile-username {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
}

.profile-flags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
}

.flag {
    padding: 0.25rem 0.5rem;
    background: rgba(0, 255, 65, 0.1);
    border: 1px solid var(--primary);
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
}

.flag.banned {
    background: rgba(255, 51, 51, 0.1);
    border-color: var(--error);
    color: var(--error);
}

.profile-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(0, 255, 65, 0.08);
}

.detail-label {
    color: var(--text-dim);
    font-size: 0.875rem;
}

.detail-value {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-family: 'JetBrains Mono', monospace;
}

.profile-description {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.description-label {
    color: var(--text-dim);
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.description-text {
    padding: 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-size: 0.8rem;
    line-height: 1.5;
    max-height: 100px;
    overflow-y: auto;
    word-break: break-word;
}

.profile-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.profile-action-btn {
    background: transparent;
    border: 1px solid var(--border-dim);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    padding: 0.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.profile-action-btn:hover {
    border-color: var(--primary);
    color: var(--text-primary);
    background: rgba(0, 255, 65, 0.05);
}

.lookup-search {
    display: flex;
    gap: 0.75rem;
}

.lookup-input {
    flex: 1;
    background: var(--bg-secondary);
    border: 1px solid var(--border-dim);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.75rem 1rem;
}

.lookup-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
}

.lookup-btn {
    background: transparent;
    border: 1px solid var(--primary);
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    padding: 0.75rem 2rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(0, 255, 65, 0.05);
}

.lookup-btn:hover:not(:disabled) {
    background: rgba(0, 255, 65, 0.1);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.3);
}

.lookup-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.lookup-result {
    margin-top: 1.5rem;
}

.lookup-profile-header {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.5rem;
}

.lookup-avatar-container {
    width: 100px;
    height: 100px;
    border: 1px solid var(--border);
    background: var(--bg-secondary);
    flex-shrink: 0;
}

.lookup-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.lookup-profile-info {
    flex: 1;
}

.lookup-display-name {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
}

.lookup-username {
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.lookup-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.lookup-detail-card {
    padding: 0.875rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-dim);
}

.lookup-detail-label {
    color: var(--text-dim);
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.375rem;
}

.lookup-detail-value {
    color: var(--text-primary);
    font-size: 0.9rem;
    font-family: 'JetBrains Mono', monospace;
}

.lookup-description {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.credits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
}

.credit-card {
    padding: 1.25rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-dim);
    text-align: center;
    transition: all 0.3s ease;
}

.credit-card:hover {
    border-color: var(--border);
    box-shadow: 0 0 15px rgba(0, 255, 65, 0.1);
}

.credit-role {
    color: var(--text-dim);
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
}

.credit-name {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 600;
}

.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal.active {
    display: flex;
}

.modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(5px);
}

.modal-content {
    position: relative;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    width: 100%;
    max-width: 400px;
    margin: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(0, 255, 65, 0.2);
}

.modal-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-dim);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.modal-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
}

.modal-close {
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease;
}

.modal-close:hover {
    color: var(--text-primary);
}

.modal-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-label {
    color: var(--text-dim);
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.form-input {
    background: var(--bg-secondary);
    border: 1px solid var(--border-dim);
    color: var(--text-primary);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    padding: 0.625rem 0.875rem;
}

.form-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.2);
}

.modal-submit-btn {
    background: rgba(0, 255, 65, 0.05);
    border: 1px solid var(--primary);
    color: var(--text-primary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    padding: 0.625rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.5rem;
}

.modal-submit-btn:hover {
    background: rgba(0, 255, 65, 0.1);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.3);
}

.modal-switch {
    text-align: center;
    font-size: 0.875rem;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
}

.modal-switch-btn {
    background: transparent;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    font-size: 0.875rem;
    text-decoration: underline;
}

.table-container::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

.table-container::-webkit-scrollbar-track {
    background: var(--bg-secondary);
}

.table-container::-webkit-scrollbar-thumb {
    background: var(--border-dim);
    border-radius: 4px;
}

.table-container::-webkit-scrollbar-thumb:hover {
    background: var(--border);
}

.description-text::-webkit-scrollbar {
    width: 6px;
}

.description-text::-webkit-scrollbar-track {
    background: var(--bg-primary);
}

.description-text::-webkit-scrollbar-thumb {
    background: var(--border-dim);
    border-radius: 3px;
}

@media (max-width: 1024px) {
    .results-grid {
        grid-template-columns: 1fr;
    }
    
    .config-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .nav-container {
        padding: 0 1rem;
        flex-wrap: wrap;
        height: auto;
        gap: 0.5rem;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
    }
    
    .nav-links {
        gap: 1rem;
        order: 3;
        width: 100%;
        justify-content: center;
        flex-wrap: wrap;
    }
    
    .nav-btn {
        font-size: 0.8rem;
    }
    
    .main-content {
        padding: 130px 1rem 2rem;
    }
    
    .hero-title {
        font-size: 2.5rem;
    }
    
    .hero-k {
        font-size: 3rem;
    }
    
    .page-title {
        font-size: 2rem;
    }
    
    .lookup-search {
        flex-direction: column;
    }
    
    .lookup-details-grid {
        grid-template-columns: 1fr;
    }
}
